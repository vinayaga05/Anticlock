# Domain and certificate settings. Point both A/AAAA records at the VPS before
# starting Caddy or Traefik so HTTPS certificates can be issued.
ACME_EMAIL=ops@example.online
ADMIN_DOMAIN=admin.anticlock.online
API_DOMAIN=api.anticlock.online

# Generate unique values; do not reuse development credentials.
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-at-least-32-random-characters

# Created only when the configured account does not already exist. Set strong
# values before the first deployment; do not use the local demo credentials.
INITIAL_ADMIN_EMAIL=admin@anticlock.online
INITIAL_ADMIN_PASSWORD=Admin@123

# Leave true for the first deploy so catalog roles and the initial admin are
# created. It is idempotent; set false later if you do not want seed updates.
RUN_SEED=true
SEED_DEMO_DATA=false

# Cloudflare R2 is the production default. Both buckets must already exist.
MEDIA_STORAGE=r2
# MP4 Reel source files are capped at 250 MB and three minutes by the API.
MEDIA_UPLOAD_MAX_VIDEO_BYTES=262144000
R2_ACCOUNT_ID=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PUBLIC=anticlock-public-media
R2_BUCKET_PRIVATE=anticlock-private-documents
R2_PUBLIC_BASE_URL=https://media.example.com

# Redis (Genie sessions, rate limiting). Internal Docker DNS in production.
REDIS_URL=redis://redis:6379

# Genie AI providers — Groq is the default for development and testing.
AI_PROVIDER=groq
# Leave unset unless OPENAI_API_KEY is also set.
# AI_FALLBACK_PROVIDER=openai
AI_REQUEST_TIMEOUT_MS=30000

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

ASSISTANT_MAX_TURNS=8
ASSISTANT_PERSONA_VERSION=1

# Algolia (reel discovery search)
ALGOLIA_APP_ID=
ALGOLIA_API_KEY=
ALGOLIA_REELS_INDEX=anticlock_reels

# Optional Cloudflare Stream configuration for reels / videos.
STREAM_ACCOUNT_ID=
STREAM_API_TOKEN=
STREAM_CUSTOMER_SUBDOMAIN=
STREAM_WEBHOOK_SECRET=
STREAM_MAX_DURATION_SECONDS=180

# GetStream Chat (1:1 messaging) - separate from Cloudflare Stream video above.
# Create an account at getstream.io and get credentials from the dashboard.
STREAM_API_KEY=
STREAM_API_SECRET=
