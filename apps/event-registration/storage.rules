rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /payment-screenshots/{mobile}/{fileName} {
      allow read: if true;
      allow write: if mobile.matches('^[0-9]{10}$')
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
