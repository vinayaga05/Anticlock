DATABASE_URL=postgres://anticlock:anticlock@localhost:5432/anticlock
JWT_SECRET=anticlock-dev-jwt-secret-change-me
ADMIN_ORIGIN=http://localhost:3000
API_PORT=4000

# Real SMS OTP. Server-side only; never copy provider credentials into mobile.
SMS_PROVIDER=bulkblaster
BULKBLASTER_API_KEY=
BULKBLASTER_BRAND_NAME=Anticlock
BULKBLASTER_SENDER_TYPE=DASSAM
# Independently generate at least 32 random characters.
OTP_HASH_SECRET=
OTP_DEV_WHITELIST=false
OTP_TEST_LOGIN_ENABLED=false
TEST_LOGIN_DISABLED=true
# Only enable behind a trusted proxy that appends the actual client IP.
OTP_TRUST_PROXY=false
# Local tests only: explicitly enable OTP_DEV_WHITELIST and/or
# OTP_TEST_LOGIN_ENABLED. Production rejects both, regardless of test number.

# Media storage: local (default) or r2
MEDIA_STORAGE=local
MEDIA_LOCAL_DIR=./.media
MEDIA_UPLOAD_MAX_IMAGE_BYTES=10485760
MEDIA_UPLOAD_MAX_DOC_BYTES=20971520
# MP4 Reel source files are additionally limited to 3 minutes in code.
MEDIA_UPLOAD_MAX_VIDEO_BYTES=262144000

# Cloudflare R2 (when MEDIA_STORAGE=r2)
# R2_ACCOUNT_ID=
# R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=          # R2 → Manage API Tokens → Object Read & Write
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_PUBLIC=reels
# R2_BUCKET_PRIVATE=anticlock-private-documents
# R2_BUCKET_EVENT_REGISTRATION=anticlock-private-documents
# R2_PUBLIC_BASE_URL=https://pub-xxxxx.r2.dev
# CORS_ORIGINS=https://knock.org.in,https://www.knock.org.in
# Cloudflare Stream video storage (optional — graceful fallback to local placeholders)
# STREAM_ACCOUNT_ID=
# STREAM_API_TOKEN=
# STREAM_CUSTOMER_SUBDOMAIN=customer-<ACCOUNT_ID>.cloudflarestream.com
# STREAM_WEBHOOK_SECRET=
# STREAM_MAX_DURATION_SECONDS=180
# Set to stream only after the Cloudflare token has Stream edit permission.
# CONTENT_VIDEO_PROVIDER=object
# STREAM_PLAYBACK_TOKEN_TTL_SECONDS=3600
# STREAM_BASIC_UPLOAD_MAX_BYTES=209715200

# Stream Chat (getstream.io) for real-time messaging
# Get credentials from https://getstream.io/dashboard/
# STREAM_API_KEY=
# STREAM_API_SECRET=

# Genie AI providers (Groq is default)
# AI_PROVIDER=groq
# AI_FALLBACK_PROVIDER=openai
# GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=openai/gpt-oss-20b
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4.1-mini
# ASSISTANT_MAX_TURNS=8

# Firebase Cloud Messaging (Push Notifications)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
